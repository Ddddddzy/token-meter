{
  "name": "token-meter-motion-film",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Token Meter deterministic 60-second product film with original synthesized music",
  "scripts": {
    "preview": "node preview.mjs",
    "studio": "remotion studio src/index.ts",
    "check": "tsc --noEmit",
    "pilot": "node render.mjs",
    "music": "node music.mjs",
    "test": "node --test video.test.mjs",
    "postprocess": "node postprocess.mjs",
    "validate": "node validate-output.mjs",
    "film": "node music.mjs && node render.mjs --film",
    "film:4k": "node music.mjs && node render.mjs --film --4k",
    "film:stills": "node music.mjs && node render.mjs --film --stills",
    "still": "node render.mjs --stills"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.534",
    "@remotion/cli": "4.0.534",
    "@remotion/renderer": "4.0.534",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.9",
    "typescript": "5.9.2"
  }
}
